<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0b0b12" />
  <title>Ideias de conteúdo — Nexa Lab</title>
  <style>
    :root{
      color-scheme:dark;
      --bg:#0b0b12;--panel:#171720;--panel-2:#1c1b26;--stroke:#333142;
      --text:#f7f4fd;--muted:#a5a1b5;--accent:#ad8aff;--accent-soft:#cab3ff;
      --radius:20px;
    }
    *{box-sizing:border-box}
    [hidden]{display:none!important}
    html{scroll-behavior:smooth}
    body{margin:0;min-height:100vh;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.5}
    body::before{content:"";position:fixed;z-index:-1;pointer-events:none;inset:0;background:radial-gradient(ellipse 56% 40% at 84% -7%,rgba(147,91,254,.21),transparent 75%),radial-gradient(ellipse 45% 44% at -15% 71%,rgba(78,55,151,.12),transparent 80%)}
    .container{width:min(1060px,calc(100% - 48px));margin-inline:auto}
    header{padding:36px 0 26px;border-bottom:1px solid rgba(255,255,255,.075)}
    .header-row{display:flex;align-items:center;justify-content:space-between;gap:16px}
    .brand{display:flex;align-items:center;gap:12px;font-size:15px;font-weight:790;letter-spacing:.04em}
    .brandmark{display:grid;place-items:center;width:36px;height:36px;border-radius:12px;background:linear-gradient(145deg,#b694ff,#7954d9);color:#161020;box-shadow:0 8px 25px rgba(147,91,254,.22)}
    .brandmark svg{width:24px;height:24px}
    .badge{border:1px solid rgba(202,179,255,.2);background:rgba(202,179,255,.07);border-radius:100px;color:#c7b1f6;padding:7px 12px;font-size:12px;font-weight:650}
    main{padding:54px 0 75px}
    .eyebrow{font-size:12px;letter-spacing:.19em;font-weight:800;color:var(--accent-soft);text-transform:uppercase}
    h1{font-size:clamp(34px,5.4vw,56px);line-height:1.06;letter-spacing:-.055em;margin:14px 0 12px;font-weight:780}
    h1 span{color:#bba0ff}
    .subtitle{color:var(--muted);font-size:15px;max-width:575px;margin:0}
    .editor{margin:36px 0 54px;padding:26px;background:linear-gradient(137deg,rgba(31,29,43,.97),rgba(21,20,30,.98));border:1px solid var(--stroke);border-radius:24px;box-shadow:0 20px 80px rgba(0,0,0,.15)}
    .editor-heading{display:flex;align-items:center;gap:9px;font-size:15px;font-weight:740;margin-bottom:21px}
    .editor-heading svg{color:var(--accent-soft)}
    .fields{display:grid;grid-template-columns:1fr 1.3fr;gap:16px}
    label{display:block;font-size:12px;font-weight:680;color:#c7c4d4;margin-bottom:8px}
    input,textarea{width:100%;background:#111119;border:1px solid #373544;border-radius:12px;color:var(--text);padding:13px 15px;font:inherit;font-size:14px;outline:none;transition:border-color .2s,box-shadow .2s}
    input::placeholder,textarea::placeholder{color:#777286}
    input:focus,textarea:focus{border-color:#a285e8;box-shadow:0 0 0 3px rgba(171,138,255,.13)}
    textarea{height:48px;min-height:48px;max-height:160px;resize:vertical}
    .form-bottom{margin-top:16px;display:flex;justify-content:flex-end;align-items:center;gap:12px}
    .button{display:inline-flex;gap:9px;justify-content:center;align-items:center;min-height:44px;border:0;border-radius:12px;background:#b797ff;color:#1c122f;padding:0 19px;font:inherit;font-size:13px;font-weight:800;cursor:pointer;transition:background .2s,transform .2s}
    .button:hover{background:#c6adff;transform:translateY(-1px)}
    .button:focus-visible,.icon-btn:focus-visible,.card-open:focus-visible{outline:3px solid #a88dfa;outline-offset:4px}
    .button.secondary{background:#302a3e;color:#e5d8ff}
    .button.secondary:hover{background:#41384f}
    .message{font-size:12px;color:#c9b6ff;min-height:18px;margin-right:auto}
    .section-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:19px}
    h2{font-size:20px;letter-spacing:-.035em;margin:0;font-weight:750}
    .counter{color:var(--muted);font-size:12px;border:1px solid var(--stroke);padding:6px 11px;border-radius:99px}
    .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}
    .card{min-width:0;overflow:hidden;border:1px solid #333141;background:rgba(23,22,32,.96);border-radius:18px;transition:border-color .2s,transform .2s;display:flex;flex-direction:column}
    .card:hover{border-color:#695487;transform:translateY(-2px)}
    .card-cover{position:relative;min-height:147px;text-decoration:none;color:inherit;background:radial-gradient(circle at 75% 15%,rgba(219,200,255,.22),transparent 40%),linear-gradient(135deg,#342747,#18151f 75%);display:flex;align-items:center;justify-content:center;overflow:hidden}
    .card-cover::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.17),transparent 70%);pointer-events:none}
    .cover-pattern{position:absolute;inset:0;opacity:.20;background-image:radial-gradient(#d8c6fa 0.7px,transparent .7px);background-size:18px 18px;mask-image:linear-gradient(90deg,transparent,#000)}
    .platform-pill{position:absolute;z-index:1;left:14px;top:14px;font-size:11px;font-weight:700;padding:6px 10px;border-radius:8px;background:rgba(15,12,22,.67);border:1px solid rgba(255,255,255,.13);backdrop-filter:blur(10px)}
    .play{width:55px;height:55px;display:grid;place-items:center;border-radius:50%;background:rgba(243,236,255,.13);border:1px solid rgba(255,255,255,.22);color:#fff;backdrop-filter:blur(9px);transition:transform .2s;z-index:1}
    .card:hover .play{transform:scale(1.08)}
    .play svg{width:22px;height:22px;margin-left:3px}
    .cover-youtube{background-size:cover;background-position:center}
    .cover-youtube::before{content:"";position:absolute;inset:0;background:rgba(5,5,10,.32)}
    .card-body{padding:18px;display:flex;flex-direction:column;flex:1}
    .description{white-space:pre-wrap;overflow-wrap:anywhere;font-size:14px;font-weight:570;line-height:1.65;margin:0 0 18px;color:#eeeaf6;flex:1}
    .card-footer{border-top:1px solid #35313f;padding-top:13px;display:flex;align-items:center;justify-content:space-between;gap:8px}
    .card-open{display:inline-flex;align-items:center;gap:7px;text-decoration:none;font-size:12px;font-weight:740;color:#cbb5ff}
    .card-open:hover{text-decoration:underline}
    .card-actions{display:flex;gap:4px}
    .icon-btn{display:grid;place-items:center;width:32px;height:32px;border:0;background:transparent;border-radius:8px;cursor:pointer;color:#9892ac}
    .icon-btn:hover{background:#2b2638;color:#fff}
    .icon-btn.danger:hover{color:#ffa0a8;background:#422431}
    .icon-btn svg{width:15px;height:15px}
    .empty{grid-column:1/-1;padding:62px 18px;text-align:center;border:1px dashed #474052;border-radius:20px;background:rgba(20,18,28,.57)}
    .empty-icon{margin:0 auto 15px;display:grid;place-items:center;width:58px;height:58px;border-radius:19px;background:#292238;color:#c9aefc}
    .empty-icon svg{width:25px;height:25px}
    .empty h3{margin:0 0 6px;font-size:18px;letter-spacing:-.02em}
    .empty p{margin:0;color:var(--muted);font-size:13px}
    footer{text-align:center;padding:0 0 30px;color:#807b90;font-size:12px}
    footer strong{color:#bba6e6;font-weight:750}
    @media(max-width:820px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.fields{grid-template-columns:1fr}}
    @media(max-width:560px){.container{width:min(100% - 32px,1060px)}header{padding:24px 0 21px}.badge{font-size:10px;padding:6px 9px}main{padding:39px 0 55px}.subtitle{font-size:14px}.editor{margin:29px 0 42px;padding:19px;border-radius:18px}.grid{grid-template-columns:1fr}.card-cover{min-height:170px}.form-bottom{flex-wrap:wrap}.form-bottom .button{width:100%}.message{width:100%}.section-heading{align-items:baseline}}
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}}
  </style>
</head>
<body>
  <header>
    <div class="container header-row">
      <div class="brand" aria-label="Nexa Lab">
        <span class="brandmark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none"><path d="M7 24V8l18 16V8" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="24.8" cy="8" r="2.5" fill="currentColor"/></svg>
        </span>
        NEXA LAB
      </div>
      <span class="badge">Banco de ideias</span>
    </div>
  </header>
  <main class="container">
    <div class="eyebrow">Seu cantinho criativo</div>
    <h1>Uma ideia puxa <span>outra.</span></h1>
    <p class="subtitle">Guarde vídeos que despertam ideias para os próximos conteúdos da Nexa. Simples, organizado e sem perder aquela inspiração.</p>

    <section class="editor" aria-labelledby="add-title">
      <div class="editor-heading" id="add-title">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        <span id="form-title">Adicionar uma ideia</span>
      </div>
      <form id="idea-form">
        <div class="fields">
          <div>
            <label for="video-url">Link do vídeo</label>
            <input id="video-url" type="url" placeholder="https://instagram.com/reel/..." required maxlength="2048" autocomplete="url" />
          </div>
          <div>
            <label for="video-description">Descrição / ideia de conteúdo</label>
            <textarea id="video-description" placeholder="Ex.: Usar essa trend para mostrar um site divertido..." required maxlength="1500"></textarea>
          </div>
        </div>
        <div class="form-bottom">
          <span class="message" id="form-message" role="status" aria-live="polite"></span>
          <button type="button" id="cancel-edit" class="button secondary" hidden>Cancelar</button>
          <button type="submit" class="button" id="submit-button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            <span id="submit-label">Salvar ideia</span>
          </button>
        </div>
      </form>
    </section>

    <section aria-labelledby="ideas-title">
      <div class="section-heading">
        <h2 id="ideas-title">Ideias salvas</h2>
        <span class="counter" id="idea-count">0 ideias</span>
      </div>
      <div class="grid" id="idea-grid"></div>
    </section>
  </main>
  <footer class="container">Feito para dar vida às ideias da <strong>Nexa Lab</strong> ✳</footer>
  <script>
    (() => {
      'use strict';
      const STORAGE_KEY = 'nexa-lab-ideias-v1';
      const form = document.querySelector('#idea-form');
      const urlInput = document.querySelector('#video-url');
      const descriptionInput = document.querySelector('#video-description');
      const grid = document.querySelector('#idea-grid');
      const count = document.querySelector('#idea-count');
      const message = document.querySelector('#form-message');
      const title = document.querySelector('#form-title');
      const submitLabel = document.querySelector('#submit-label');
      const cancelBtn = document.querySelector('#cancel-edit');
      let editingId = null;
      let items = readItems();

      function readItems(){
        try {
          const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          return Array.isArray(stored) ? stored.filter(x => x && typeof x.url === 'string' && typeof x.description === 'string') : [];
        } catch { return []; }
      }
      function persist(){
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(items)); return true; }
        catch { message.textContent = 'Não foi possível salvar neste navegador. Verifique as configurações de armazenamento.'; return false; }
      }
      function platformInfo(url){
        try {
          const host = new URL(url).hostname.toLowerCase().replace(/^www\./, '');
          if (host === 'instagram.com' || host.endsWith('.instagram.com')) return 'Instagram';
          if (host === 'tiktok.com' || host.endsWith('.tiktok.com')) return 'TikTok';
          if (host === 'youtube.com' || host.endsWith('.youtube.com') || host === 'youtu.be' || host === 'youtube-nocookie.com') return 'YouTube';
          if (host === 'pinterest.com' || host.endsWith('.pinterest.com') || host === 'pin.it') return 'Pinterest';
          if (host === 'facebook.com' || host.endsWith('.facebook.com') || host === 'fb.watch') return 'Facebook';
          if (host === 'vimeo.com' || host.endsWith('.vimeo.com')) return 'Vimeo';
          if (host === 'x.com' || host === 'twitter.com') return 'X / Twitter';
          return 'Vídeo / referência';
        } catch { return 'Vídeo / referência'; }
      }
      function youtubeId(url){
        try {
          const u = new URL(url), host = u.hostname.replace(/^www\./,'').toLowerCase();
          let id = null;
          if (host === 'youtu.be') id = u.pathname.split('/')[1];
          else if (host === 'youtube.com' || host === 'm.youtube.com') {
            if (u.pathname === '/watch') id = u.searchParams.get('v');
            else if (/^\/(shorts|embed|live)\//.test(u.pathname)) id = u.pathname.split('/')[2];
          }
          return /^[\w-]{11}$/.test(id || '') ? id : null;
        } catch { return null; }
      }
      function icon(name){
        const paths = {
          play:'<path d="m9 6 10 6-10 6V6Z" fill="currentColor" stroke="none"/>',
          edit:'<path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4L16.5 3.5Z"/>',
          trash:'<path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m5 4v6m4-6v6"/>',
          arrow:'<path d="M7 17 17 7M8 7h9v9"/>',
          folder:'<rect x="3" y="7" width="18" height="14" rx="2"/><path d="M3 10V5a2 2 0 0 1 2-2h5l2 4"/>'
        };
        return `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths[name]}</svg>`;
      }
      function render(){
        grid.replaceChildren();
        count.textContent = `${items.length} ${items.length === 1 ? 'ideia' : 'ideias'}`;
        if (!items.length){
          const empty = document.createElement('div');
          empty.className = 'empty';
          empty.innerHTML = `<div class="empty-icon">${icon('folder')}</div><h3>Sua próxima grande ideia começa aqui.</h3><p>Cole o primeiro link ali em cima e bora criar!</p>`;
          grid.append(empty);
          return;
        }
        for (const item of items){
          const article = document.createElement('article');
          article.className = 'card';
          const cover = document.createElement('a');
          cover.className = 'card-cover';
          cover.href = item.url;
          cover.target = '_blank';
          cover.rel = 'noopener noreferrer';
          cover.setAttribute('aria-label', 'Abrir vídeo em nova aba');
          const id = youtubeId(item.url);
          if (id) {
            cover.classList.add('cover-youtube');
            cover.style.backgroundImage = `url("https://i.ytimg.com/vi/${id}/hqdefault.jpg")`;
          }
          const pattern = document.createElement('div');
          pattern.className = 'cover-pattern';
          const platform = document.createElement('span');
          platform.className = 'platform-pill';
          platform.textContent = platformInfo(item.url);
          const play = document.createElement('div');
          play.className = 'play';
          play.innerHTML = icon('play');
          cover.append(pattern, platform, play);
          const body = document.createElement('div');
          body.className = 'card-body';
          const desc = document.createElement('p');
          desc.className = 'description';
          desc.textContent = item.description;
          const footer = document.createElement('div');
          footer.className = 'card-footer';
          const openLink = document.createElement('a');
          openLink.className = 'card-open';
          openLink.href = item.url;
          openLink.target = '_blank';
          openLink.rel = 'noopener noreferrer';
          openLink.innerHTML = `Abrir vídeo ${icon('arrow')}`;
          const actions = document.createElement('div');
          actions.className = 'card-actions';
          const editBtn = document.createElement('button');
          editBtn.type = 'button';
          editBtn.className = 'icon-btn';
          editBtn.title = 'Editar ideia';
          editBtn.setAttribute('aria-label','Editar ideia');
          editBtn.innerHTML = icon('edit');
          editBtn.addEventListener('click', () => editItem(item.id));
          const deleteBtn = document.createElement('button');
          deleteBtn.type = 'button';
          deleteBtn.className = 'icon-btn danger';
          deleteBtn.title = 'Excluir ideia';
          deleteBtn.setAttribute('aria-label','Excluir ideia');
          deleteBtn.innerHTML = icon('trash');
          deleteBtn.addEventListener('click', () => deleteItem(item.id));
          actions.append(editBtn, deleteBtn);
          footer.append(openLink,actions);
          body.append(desc,footer);
          article.append(cover,body);
          grid.append(article);
        }
      }
      function resetForm(){
        editingId = null;
        form.reset();
        title.textContent = 'Adicionar uma ideia';
        submitLabel.textContent = 'Salvar ideia';
        cancelBtn.hidden = true;
        message.textContent = '';
      }
      function editItem(id){
        const item = items.find(x => x.id === id);
        if (!item) return;
        editingId = id;
        urlInput.value = item.url;
        descriptionInput.value = item.description;
        title.textContent = 'Editar ideia';
        submitLabel.textContent = 'Salvar alterações';
        cancelBtn.hidden = false;
        message.textContent = '';
        document.querySelector('.editor').scrollIntoView({behavior:'smooth',block:'center'});
        urlInput.focus({preventScroll:true});
      }
      function deleteItem(id){
        if (!confirm('Excluir esta ideia?')) return;
        const before = items;
        items = items.filter(x => x.id !== id);
        if (!persist()) { items = before; return; }
        if (editingId === id) resetForm();
        render();
      }
      form.addEventListener('submit',event => {
        event.preventDefault();
        message.textContent = '';
        const urlValue = urlInput.value.trim();
        const description = descriptionInput.value.trim();
        let u;
        try { u = new URL(urlValue); } catch { message.textContent = 'Cole um link válido.'; return; }
        if (!['http:','https:'].includes(u.protocol) || !u.hostname.includes('.')){message.textContent = 'Use um link http ou https válido.';return;}
        if (!description){message.textContent = 'Escreva uma descrição para a ideia.';return;}
        const before = items.slice();
        if (editingId){
          items = items.map(item => item.id === editingId ? {...item,url:u.href,description} : item);
        } else {
          items.unshift({id:globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random()}`,url:u.href,description});
        }
        if (!persist()) {items = before;return;}
        resetForm();
        render();
      });
      cancelBtn.addEventListener('click',resetForm);
      render();
    })();
  </script>
</body>
</html>
